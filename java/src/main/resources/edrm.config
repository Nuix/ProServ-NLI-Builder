encoding = UTF-8
# csv_encoding controls the declared character encoding used when reading CSV files.
# NOTE: Java does not recognise "UTF-8-SIG" as a valid charset name (unlike Python, which
# uses it to transparently strip the BOM). Instead, BOM stripping is always applied
# unconditionally in CSVEntry via an explicit \uFEFF character check on the first header
# character. This key therefore only controls the byte-level decoding charset; set it to
# "UTF-8" (the default) for the vast majority of CSV files. Change it only when your source
# files use a different encoding (e.g. "windows-1252" or "ISO-8859-1").
csv_encoding = UTF-8
date_time_format = yyyy-MM-dd'T'HH:mm:ss.SSS
time_zone_format = +00:00
hash_buffer_size = 65536
custodian = Unknown
default_itemdate_field = CreateTime
default_rowname_field = Name
